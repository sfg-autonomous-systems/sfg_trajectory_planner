<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sfg_trajectory_planner</name>
  <version>0.0.0</version>
  <description>GUI tool to create and orchestrate robot trajectories for multi-agent systems.</description>
  <maintainer email="constantin.blessing@hs-esslingen.de">Constantin Blessing</maintainer>
  <license>MIT</license>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sfg_imgui_vendor</depend>
  <depend>sfg_utils</depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>